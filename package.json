{
  "name": "opencode-motion-video-director",
  "version": "0.1.0",
  "description": "Plan, direct, and produce code-drawn 2D/3D motion graphics and edited videos locally with OpenCode. Installs the motion-video-director skill plus a /mvd-setup preflight command and optional MCP auto-configuration.",
