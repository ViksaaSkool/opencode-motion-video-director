    "test": "bun test",
    "check": "bunx tsc --noEmit",
    "build:catalog": "node scripts/build-catalog.mjs"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-skill",
    "video",
    "motion-graphics",
    "animation",
    "ffmpeg",
    "agent-skills"
  ],
  "license": "MIT",
  "author": "Viktor Arsovski",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ViksaaSkool/opencode-motion-video-director.git"
  },
  "bugs": {
    "url": "https://github.com/ViksaaSkool/opencode-motion-video-director/issues"
  },
  "homepage": "https://github.com/ViksaaSkool/opencode-motion-video-director#readme",
  "dependencies": {
    "@opencode/plugin": "latest"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "latest"
  }
}
